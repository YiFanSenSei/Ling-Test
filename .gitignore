# 依赖与构建产物
node_modules/
dist/

# 由 scripts/split-details.mjs 从 details.json 生成的详情分片与小索引。
# 它们是构建中间产物（内容与 details.json 重复），不入库；
# pnpm dev / pnpm build 前会自动重新生成（见 package.json 的 predev / prebuild）。
public/data/detail-*.js
public/data/detail-index.json
public/data/featured.json
public/data/inheritors.js
public/data/inheritor-stats.json

# 本机测试截图（数十 MB，且含本机渲染结果）
_shots/

# 提交用的压缩包（含个人信息，绝不入库）
_submit/

# 临时文件与日志
*.log
*.tmp
*.bak

# 一次性诊断 / 修补脚本。
# 这些是每轮调试现写现用的（_fix-xxx.cjs、_peek.cjs…），问题修完就没有价值了，
# 留在仓库里只会让 scripts/ 变成垃圾场。需要长期运行的验证脚本用正式名字（无下划线前缀）。
scripts/_*.cjs
scripts/_*.mjs
scripts/_*.py

# 操作系统杂项
.DS_Store
Thumbs.db
